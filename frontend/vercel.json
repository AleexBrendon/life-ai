{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [{ "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lifeai-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
