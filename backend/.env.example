DATABASE_URL="postgresql://lifeai:lifeai@localhost:5433/lifeai?schema=public"

REDIS_URL="redis://localhost:6380"

JWT_SECRET=

PORT=3010
# Limite compartilhado entre as rotas de geração da IA por usuário autenticado.
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Links de calendários: chave AES-256 em hexadecimal (64 caracteres).
CALENDAR_ENCRYPTION_KEY=
# Web Push: gerar um par estável com npm run push:keys e configurar no ambiente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Assistente IA (OpenRouter). Pedidos de rotina funcionam sem a chave; ela é usada em perguntas gerais e explicações.
OPENROUTER_API_KEY=
# Modelo principal. Um modelo rápido evita esperas, ex.: minimax/minimax-m3.1-flash:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Reservas tentadas em ordem quando o principal falha, demora ou responde vazio (separadas por vírgula).
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,xingchen-agi/xing4.0-29b-a4b:free

OPENROUTER_SETUP_MODEL=nvidia/nemotron-3.5-super-vl:free
