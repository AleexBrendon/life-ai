DATABASE_URL="postgresql://lifeai:lifeai@localhost:5432/lifeai?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_SECRET=

PORT=3000
# Assistente IA (OpenRouter). Pedidos de rotina funcionam sem a chave; ela é usada em perguntas gerais e explicações.
OPENROUTER_API_KEY=
# Modelo principal. Um modelo rápido evita esperas, ex.: minimax/minimax-m3.1-flash:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Reservas tentadas em ordem quando o principal falha, demora ou responde vazio (separadas por vírgula).
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,xingchen-agi/xing4.0-29b-a4b:free

OPENROUTER_SETUP_MODEL=nvidia/nemotron-3.5-super-vl:free
