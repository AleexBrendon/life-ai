  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
  }

  model User {
    id           Int      @id @default(autoincrement())
    name         String
    email        String   @unique
    passwordHash String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    profile            Profile?
    jobs               Job[]
    routineItems       RoutineItem[]
    routineExecutions  RoutineExecution[]
    unexpectedEvents   UnexpectedEvent[]
    reminders          Reminder[]
    reminderExecutions ReminderExecution[]
    notifications      Notification[]
    aiRecommendations  AiRecommendation[]
    goals              Goal[]
    hydrationPlan      HydrationPlan?
    waterIntakes       WaterIntake[]
    financeEntries     FinanceEntry[]
    financeBills       FinanceBill[]
    activityExecutions ActivityExecution[]
    routineCycles      RoutineCycle[]
    routineCheckins    RoutineCheckin[]
    jobTaskTimeLogs    JobTaskTimeLog[]
    jobTaskEvents      JobTaskEvent[]
    calendarConnections CalendarConnection[]
    calendarImports CalendarImport[]
    calendarLinks CalendarLink[]
    pushPreference PushPreference?
    pushSubscriptions PushSubscription[]
    weeklyReviews WeeklyReview[]
    syncReceipts SyncReceipt[]
  }

  model ActivityExecution {
    id          Int @id @default(autoincrement())
    userId      Int
    kind        String
    sourceId    Int
    date        DateTime @db.Date
    status      String @default("PENDING")
    skipReason  String?
    completedAt DateTime?
    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@unique([userId, kind, sourceId, date])
    @@index([userId, date])
  }

  model HydrationPlan {
    id              Int @id @default(autoincrement())
    userId          Int @unique
    goalMl          Int @default(2000)
    cupMl           Int @default(250)
    intervalMinutes Int @default(120)
    startTime       String @default("08:00")
    endTime         String @default("20:00")
    enabled         Boolean @default(false)
    lastReminderKey String?
    user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  }

  model WaterIntake {
    id        Int @id @default(autoincrement())
    userId    Int
    amountMl  Int
    date      DateTime @db.Date
    createdAt DateTime @default(now())
    user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@index([userId, date])
  }

  model FinanceEntry {
    id           Int @id @default(autoincrement())
    userId       Int
    kind         String
    category     String @default("Outros")
    isVariable   Boolean @default(false)
    title        String
    amountCents  Int
    savedCents   Int @default(0)
    monthlyCents Int @default(0)
    installments Int @default(1)
    scheduledBill FinanceBill?
    createdAt    DateTime @default(now())
    user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@index([userId, kind])
  }

  model FinanceBill {
    id          Int @id @default(autoincrement())
    userId      Int
    title       String
    kind        String @default("EXPENSE")
    isVariable  Boolean @default(false)
    sourceEntryId Int? @unique
    sourceEntry FinanceEntry? @relation(fields: [sourceEntryId], references: [id], onDelete: SetNull)
    category    String @default("Outros")
    description String?
    amountCents Int
    firstDueDate DateTime @db.Date
    recurrence  String @default("ONCE")
    monthly     Boolean @default(false)
    endDate     DateTime? @db.Date
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    occurrences FinanceBillOccurrence[]
    @@index([userId])
  }

  model FinanceBillOccurrence {
    id            Int @id @default(autoincrement())
    billId        Int
    referenceDate DateTime @db.Date
    dueDate       DateTime @db.Date
    status        String @default("PENDING")
    amountCents   Int
    paidAt        DateTime? @db.Date
    reason        String?
    updatedAt     DateTime @updatedAt
    bill          FinanceBill @relation(fields: [billId], references: [id], onDelete: Cascade)
    history       FinanceBillEvent[]
    @@unique([billId, referenceDate])
    @@index([dueDate])
  }

  model FinanceBillEvent {
    id           Int @id @default(autoincrement())
    occurrenceId Int
    status       String
    dueDate      DateTime @db.Date
    paidAt       DateTime? @db.Date
    reason       String?
    createdAt    DateTime @default(now())
    occurrence   FinanceBillOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
    @@index([occurrenceId])
  }

  model Profile {
    id                 Int       @id @default(autoincrement())
    userId             Int       @unique
    birthDate          DateTime?
    timezone           String    @default("America/Sao_Paulo")
    occupation         String?
    relationshipStatus String?
    hasChildren        Boolean   @default(false)
    avatarData         String?
    calendarView       String    @default("month")
    weekStartsOn       Int       @default(1)
    notifyActions      Boolean   @default(true)
    notifyUpcoming     Boolean   @default(true)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }


  model Job {
    id       Int     @id @default(autoincrement())
    userId   Int
    name     String
    company  String?
    position String?
    workType String?
    location String?
    isActive Boolean @default(true)
    preparationMinutes Int?
    outboundMinutes Int?
    returnMinutes Int?
    travelDuringBreak Boolean @default(false)
    status   String  @default("TODO")

    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    schedules   WorkSchedule[]
    tasks       JobTask[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
  }

  model JobTask {
    id          Int      @id @default(autoincrement())
    jobId       Int
    title       String
    description String?
    status      String   @default("TODO")
    project          String?
    repositoryUrl    String?
    priority         String    @default("MEDIUM")
    position         Int       @default(0)
    dueDate          DateTime? @db.Date
    estimatedMinutes Int?
    completedAt      DateTime?

    job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
    timeLogs  JobTaskTimeLog[]
    events    JobTaskEvent[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([jobId, status])
  }

  // One row per tracked interval; an open interval (endedAt null) means the timer is running.
  model JobTaskTimeLog {
    id        Int       @id @default(autoincrement())
    taskId    Int
    userId    Int
    startedAt DateTime
    endedAt   DateTime?
    createdAt DateTime  @default(now())

    task JobTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, startedAt])
    @@index([taskId])
  }

  model JobTaskEvent {
    id         Int      @id @default(autoincrement())
    taskId     Int
    userId     Int
    type       String
    fromStatus String?
    toStatus   String?
    reason     String?
    createdAt  DateTime @default(now())

    task JobTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([taskId, createdAt])
    @@index([userId])
  }

  model WorkSchedule {
    id         Int     @id @default(autoincrement())
    jobId      Int
    dayOfWeek  Int
    startTime  String
    endTime    String
    breakStart String?
    breakEnd   String?

    job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([jobId])
  }

  model RoutineItem {
    id       Int     @id @default(autoincrement())
    userId   Int
    name     String
    type     String
    isActive Boolean @default(true)
    isFlexible Boolean @default(false)
    locationMode String?
    preparationMinutes Int?
    outboundMinutes Int?
    returnMinutes Int?
    travelDuringBreak Boolean @default(false)
    autoSchedule Boolean @default(false)
    weeklyFrequency Int @default(3)
    sessionMinutes Int @default(30)

    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    schedules         RoutineSchedule[]
    routineExecutions RoutineExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
  }

  model RoutineSchedule {
    id            Int    @id @default(autoincrement())
    routineItemId Int
    dayOfWeek     Int
    startTime     String
    endTime       String

    routineItem       RoutineItem        @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
    routineExecutions RoutineExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([routineItemId])
  }

  model RoutineExecution {
    id                Int       @id @default(autoincrement())
    userId            Int
    routineItemId     Int
    routineScheduleId Int
    date              DateTime
    startTime         String
    endTime           String
    status            String
    completedAt       DateTime?
    skipReason        String?

    user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    routineItem     RoutineItem     @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
    routineSchedule RoutineSchedule @relation(fields: [routineScheduleId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, routineScheduleId, date])
    @@index([userId, date])
    @@index([routineItemId])
    @@index([routineScheduleId])
  }

  model UnexpectedEvent {
    id          Int      @id @default(autoincrement())
    userId      Int
    title       String
    description String?
    date        DateTime
    startTime   String
    endTime     String
    priority    String
    status      String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    calendarLink CalendarLink?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, date])
  }

  model Reminder {
    id           Int       @id @default(autoincrement())
    userId       Int
    title        String
    description  String?
    reminderTime String
    date         DateTime?
    dayOfWeek    Int?
    recurrence   String    @default("NONE")
    isCompleted  Boolean   @default(false)
    isActive     Boolean   @default(true)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    reminderExecutions ReminderExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([userId, date])
  }

  model ReminderExecution {
    id          Int       @id @default(autoincrement())
    userId      Int
    reminderId  Int
    date        DateTime
    status      String
    completedAt DateTime?

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, reminderId, date])
    @@index([userId, date])
    @@index([reminderId])
  }

  model Notification {
    id     Int @id @default(autoincrement())
    userId Int

    title   String
    message String

    type     String
    priority String @default("MEDIUM")

    isRead Boolean   @default(false)
    readAt DateTime?

    scheduledAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    entityType String?
    entityId   Int?
    dedupKey   String? @unique
    hydrationConfirmedAt DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    pushDeliveries PushDelivery[]

    @@index([userId])
    @@index([userId, isRead])
    @@index([userId, scheduledAt])
  }

  model AiRecommendation {
    id         Int      @id @default(autoincrement())
    userId     Int
    date       DateTime
    action     String
    targetType String
    targetId   Int?
    reason     String
    confidence Float
    changes    Json
    status     String   @default("PENDING")
    approvedAt DateTime?
    rejectedAt DateTime?
    executedAt DateTime?
    result     Json?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, status])
    @@index([userId, date])
    @@map("AIRecommendation")
  }

  model Goal {
    id              Int      @id @default(autoincrement())
    userId          Int
    title           String
    description     String?
    targetDate      DateTime?
    weeklyFrequency Int      @default(3)
    sessionMinutes  Int      @default(60)
    autoSchedule    Boolean  @default(false)
    priority        String   @default("MEDIUM")
    status          String   @default("ACTIVE")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    sessions GoalPlanSession[]
    milestones GoalMilestone[]

    @@index([userId, status])
  }

  model GoalPlanSession {
    id        Int      @id @default(autoincrement())
    goalId    Int
    date      DateTime
    startTime String
    endTime   String
    status    String   @default("PENDING")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
    progressEntries MilestoneProgress[]

    @@index([goalId, date])
    @@unique([goalId, date, startTime])
  }

  // Monthly routine cycle: the approved weekly template, its results and the user's check-ins.
  model RoutineCycle {
    id               Int       @id @default(autoincrement())
    userId           Int
    startDate        DateTime  @db.Date
    endDate          DateTime  @db.Date
    status           String    @default("ACTIVE")
    optionId         String
    recommendationId Int?
    template         Json
    metrics          Json?
    performance      Json?
    goalSessionIds   Json?
    closedAt         DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    checkins RoutineCheckin[]

    @@index([userId, status])
  }

  model RoutineCheckin {
    id        Int      @id @default(autoincrement())
    cycleId   Int
    userId    Int
    step      Int
    date      DateTime @db.Date
    answers   Json
    createdAt DateTime @default(now())

    cycle RoutineCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
    user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([cycleId, step])
    @@index([userId])
  }

model CalendarConnection {
  id Int @id @default(autoincrement())
  userId Int
  name String
  encryptedUrl String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model CalendarImport {
  id Int @id @default(autoincrement())
  userId Int
  sourceKey String
  name String
  rows Json
  fingerprint String
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model CalendarLink {
  id Int @id @default(autoincrement())
  userId Int
  sourceKey String
  externalKey String
  eventId Int? @unique
  lastAppliedHash String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event UnexpectedEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@unique([userId, sourceKey, externalKey])
}
model PushPreference {
  userId Int @id
  enabled Boolean @default(false)
  quietEnabled Boolean @default(true)
  quietStart String @default("22:00")
  quietEnd String @default("07:00")
  upcoming Boolean @default(true)
  hydration Boolean @default(true)
  actions Boolean @default(false)
  showDetails Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model PushSubscription {
  id Int @id @default(autoincrement())
  userId Int
  endpoint String @unique
  keys Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId])
}
model PushDelivery {
  id Int @id @default(autoincrement())
  notificationId Int
  subscriptionId Int
  status String @default("PENDING")
  attempts Int @default(0)
  lockedUntil DateTime?
  sentAt DateTime?
  errorCode String?
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([notificationId, subscriptionId])
  @@index([status, lockedUntil])
}
model WeeklyReview {
  id Int @id @default(autoincrement())
  userId Int
  weekStart DateTime @db.Date
  metrics Json
  suggestions Json
  accepted Json @default("[]")
  notes String @default("")
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, weekStart])
}
model GoalMilestone {
  id Int @id @default(autoincrement())
  goalId Int
  title String
  unit String @default("unidades")
  target Float
  createdAt DateTime @default(now())
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  entries MilestoneProgress[]
  @@index([goalId])
}
model MilestoneProgress {
  id Int @id @default(autoincrement())
  milestoneId Int
  sessionId Int?
  amount Float
  note String @default("")
  createdAt DateTime @default(now())
  milestone GoalMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  session GoalPlanSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@unique([milestoneId, sessionId])
  @@index([sessionId])
}
model SyncReceipt {
  id Int @id @default(autoincrement())
  userId Int
  operationId String
  hash String
  result Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, operationId])
}
