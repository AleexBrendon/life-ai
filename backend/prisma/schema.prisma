  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
  }

  model User {
    id           Int      @id @default(autoincrement())
    name         String
    email        String   @unique
    passwordHash String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    profile            Profile?
    jobs               Job[]
    routineItems       RoutineItem[]
    routineExecutions  RoutineExecution[]
    unexpectedEvents   UnexpectedEvent[]
    reminders          Reminder[]
    reminderExecutions ReminderExecution[]
    notifications      Notification[]
    aiRecommendations  AiRecommendation[]
    goals              Goal[]
    hydrationPlan      HydrationPlan?
    waterIntakes       WaterIntake[]
    financeEntries     FinanceEntry[]
    activityExecutions ActivityExecution[]
  }

  model ActivityExecution {
    id          Int @id @default(autoincrement())
    userId      Int
    kind        String
    sourceId    Int
    date        DateTime @db.Date
    status      String @default("PENDING")
    skipReason  String?
    completedAt DateTime?
    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@unique([userId, kind, sourceId, date])
    @@index([userId, date])
  }

  model HydrationPlan {
    id              Int @id @default(autoincrement())
    userId          Int @unique
    goalMl          Int @default(2000)
    cupMl           Int @default(250)
    intervalMinutes Int @default(120)
    startTime       String @default("08:00")
    endTime         String @default("20:00")
    enabled         Boolean @default(false)
    lastReminderKey String?
    user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  }

  model WaterIntake {
    id        Int @id @default(autoincrement())
    userId    Int
    amountMl  Int
    date      DateTime @db.Date
    createdAt DateTime @default(now())
    user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@index([userId, date])
  }

  model FinanceEntry {
    id           Int @id @default(autoincrement())
    userId       Int
    kind         String
    title        String
    amountCents  Int
    savedCents   Int @default(0)
    monthlyCents Int @default(0)
    installments Int @default(1)
    createdAt    DateTime @default(now())
    user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
    @@index([userId, kind])
  }

  model Profile {
    id                 Int       @id @default(autoincrement())
    userId             Int       @unique
    birthDate          DateTime?
    timezone           String    @default("America/Sao_Paulo")
    occupation         String?
    relationshipStatus String?
    hasChildren        Boolean   @default(false)
    avatarData         String?
    calendarView       String    @default("month")
    weekStartsOn       Int       @default(1)
    notifyActions      Boolean   @default(true)
    notifyUpcoming     Boolean   @default(true)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }


  model Job {
    id       Int     @id @default(autoincrement())
    userId   Int
    name     String
    company  String?
    position String?
    workType String?
    location String?
    isActive Boolean @default(true)
    status   String  @default("TODO")

    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    schedules   WorkSchedule[]
    tasks       JobTask[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }

  model JobTask {
    id          Int      @id @default(autoincrement())
    jobId       Int
    title       String
    description String?
    status      String   @default("TODO")

    job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([jobId, status])
  }

  model WorkSchedule {
    id         Int     @id @default(autoincrement())
    jobId      Int
    dayOfWeek  Int
    startTime  String
    endTime    String
    breakStart String?
    breakEnd   String?

    job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }

  model RoutineItem {
    id       Int     @id @default(autoincrement())
    userId   Int
    name     String
    type     String
    isActive Boolean @default(true)

    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    schedules         RoutineSchedule[]
    routineExecutions RoutineExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }

  model RoutineSchedule {
    id            Int    @id @default(autoincrement())
    routineItemId Int
    dayOfWeek     Int
    startTime     String
    endTime       String

    routineItem       RoutineItem        @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
    routineExecutions RoutineExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }

  model RoutineExecution {
    id                Int       @id @default(autoincrement())
    userId            Int
    routineItemId     Int
    routineScheduleId Int
    date              DateTime
    startTime         String
    endTime           String
    status            String
    completedAt       DateTime?
    skipReason        String?

    user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    routineItem     RoutineItem     @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
    routineSchedule RoutineSchedule @relation(fields: [routineScheduleId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, routineScheduleId, date])
    @@index([userId, date])
  }

  model UnexpectedEvent {
    id          Int      @id @default(autoincrement())
    userId      Int
    title       String
    description String?
    date        DateTime
    startTime   String
    endTime     String
    priority    String
    status      String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, date])
  }

  model Reminder {
    id           Int       @id @default(autoincrement())
    userId       Int
    title        String
    description  String?
    reminderTime String
    date         DateTime?
    dayOfWeek    Int?
    recurrence   String    @default("NONE")
    isCompleted  Boolean   @default(false)
    isActive     Boolean   @default(true)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    reminderExecutions ReminderExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([userId, date])
  }

  model ReminderExecution {
    id          Int       @id @default(autoincrement())
    userId      Int
    reminderId  Int
    date        DateTime
    status      String
    completedAt DateTime?

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, reminderId, date])
    @@index([userId, date])
  }

  model Notification {
    id     Int @id @default(autoincrement())
    userId Int

    title   String
    message String

    type     String
    priority String @default("MEDIUM")

    isRead Boolean   @default(false)
    readAt DateTime?

    scheduledAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    entityType String?
    entityId   Int?
    dedupKey   String? @unique
    hydrationConfirmedAt DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([userId, isRead])
    @@index([userId, scheduledAt])
  }

  model AiRecommendation {
    id         Int      @id @default(autoincrement())
    userId     Int
    date       DateTime
    action     String
    targetType String
    targetId   Int?
    reason     String
    confidence Float
    changes    Json
    status     String   @default("PENDING")
    approvedAt DateTime?
    rejectedAt DateTime?
    executedAt DateTime?
    result     Json?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, status])
    @@index([userId, date])
    @@map("AIRecommendation")
  }

  model Goal {
    id              Int      @id @default(autoincrement())
    userId          Int
    title           String
    description     String?
    targetDate      DateTime?
    weeklyFrequency Int      @default(3)
    sessionMinutes  Int      @default(60)
    priority        String   @default("MEDIUM")
    status          String   @default("ACTIVE")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    sessions GoalPlanSession[]

    @@index([userId, status])
  }

  model GoalPlanSession {
    id        Int      @id @default(autoincrement())
    goalId    Int
    date      DateTime
    startTime String
    endTime   String
    status    String   @default("PENDING")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

    @@index([goalId, date])
    @@unique([goalId, date, startTime])
  }
